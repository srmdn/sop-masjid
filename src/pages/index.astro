---
import Site from '../layouts/Site.astro';
import { href } from '../lib/materials';
const areas = [
  ['01', 'Petugas & ibadah', 'Jadwal imam, muadzin, konfirmasi tugas, dan pengganti.', 'paket/mushola-starter/template/jadwal-imam', 'Jadwal petugas'],
  ['02', 'Kebersihan area', 'Pemeriksaan ruang shalat, toilet, tempat wudhu, dan sampah.', 'paket/mushola-starter/sop/kebersihan', 'SOP kebersihan'],
  ['03', 'Fasilitas & persediaan', 'Catat kondisi alat, stok barang, kerusakan, dan perawatan.', 'paket/masjid-dasar/alat-kerja/#persediaan-dan-perawatan', 'Format pemeriksaan'],
  ['04', 'Kas & belanja', 'Catat transaksi, simpan bukti, dan periksa saldo.', 'paket/mushola-starter/template/kas', 'Struktur buku kas'],
  ['05', 'Jumat & kajian', 'Konfirmasi pelaksana, siapkan tempat, dan catat perubahan acara.', 'paket/masjid-dasar/sop-inti/#sop-06--koordinasi-kajian-rutin', 'SOP kegiatan'],
  ['06', 'Koordinasi harian', 'Bagi tugas, lakukan serah-terima, dan tindak lanjuti kendala.', 'paket/masjid-dasar', 'Pembagian peran'],
];
const tools = [
  ['01', 'Jadwal imam / muadzin', 'Struktur tabel', 'paket/mushola-starter/template/jadwal-imam'],
  ['02', 'Pemeriksaan harian', 'Checklist', 'paket/mushola-starter/checklist/harian'],
  ['03', 'Catatan kendala & serah-terima', 'Format catatan', 'paket/masjid-dasar/alat-kerja'],
];
---
<Site>
  <section class="intro wrap">
    <div class="edition"><span>REFERENSI KERJA</span><span>GRATIS · TERBUKA UNTUK ADAPTASI</span></div>
    <div class="intro-grid">
      <h1>Panduan kerja<br />masjid & mushola<span class="accent">.</span></h1>
      <div class="intro-description">
        <p>SOP, checklist, dan format catatan untuk pengurus, imam, serta petugas masjid.</p>
        <p class="muted">Pilih pekerjaan di bawah, atau baca paket untuk menyusun pembagian tugas.</p>
        <a class="inline-link" href={href('mulai')}>Cara menggunakan panduan <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="work-index wrap" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Bidang pekerjaan</h2><span class="section-label">01—06 / INDEKS</span></div>
    <div class="work-grid">
      {areas.map(([no, title, description, route, action]) => <a class="work-entry" href={route.includes('#') ? href(route.split('#')[0]) + '#' + route.split('#')[1] : href(route)}>
        <span class="entry-number">{no}</span>
        <div><h3>{title}</h3><p>{description}</p><span class="entry-action">{action} <span aria-hidden="true">↗</span></span></div>
      </a>)}
    </div>
  </section>

  <section class="desk wrap" aria-labelledby="desk-title">
    <div class="desk-copy"><p class="eyebrow">PEMERIKSAAN LAYANAN</p><h2 id="desk-title">Sebelum shalat<br />berjamaah.</h2><p>Periksa kesiapan petugas dan fasilitas. Jika ada kendala, tentukan siapa yang menindaklanjuti.</p><a class="inline-link" href={href('paket/masjid-dasar/alat-kerja')}>Baca checklist lengkap →</a></div>
    <div class="service-list"><p class="list-caption">RINGKASAN CHECKLIST</p><ol>
      <li><span>01</span><div><strong>Imam & muadzin</strong><p>Konfirmasi kehadiran dan pengganti bila diperlukan.</p></div></li>
      <li><span>02</span><div><strong>Area & air</strong><p>Periksa lantai, toilet, tempat wudhu, dan pasokan air.</p></div></li>
      <li><span>03</span><div><strong>Audio & akses</strong><p>Uji perangkat dan pastikan jalur masuk dapat digunakan.</p></div></li>
    </ol></div>
  </section>

  <section class="wrap document-section" aria-labelledby="tools-title">
    <div class="section-heading"><h2 id="tools-title">Dokumen kerja</h2><a class="inline-link" href={href('materi')}>Semua materi →</a></div>
    <div class="document-list">{tools.map(([no, title, type, route]) => <a href={href(route)}><span class="entry-number">{no}</span><h3>{title}</h3><span class="document-type">{type}</span><span class="document-arrow" aria-hidden="true">↗</span></a>)}</div>
    <p class="availability-note">Baca dan cetak langsung. Halaman template saat ini berisi struktur tabel; file unduhan belum tersedia.</p>
  </section>

  <section class="wrap collection-section" aria-labelledby="collection-title">
    <div class="section-heading"><h2 id="collection-title">Panduan dalam satu paket</h2><a class="inline-link" href={href('paket')}>Lihat paket →</a></div>
    <div class="collection-grid">
      <a href={href('paket/mushola-starter')}><span class="eyebrow">PAKET 01</span><h3>Mushola Starter</h3><p>Buka-tutup, kebersihan, kas infak, inventaris, dan jadwal petugas.</p><span class="collection-meta">4 SOP · struktur tabel · checklist <b aria-hidden="true">↗</b></span></a>
      <a href={href('paket/masjid-dasar')}><span class="eyebrow">PAKET 02</span><h3>Masjid Dasar</h3><p>Pembagian peran, pengganti, persiapan kegiatan, dan tindak lanjut kendala.</p><span class="collection-meta">10 SOP inti · format catatan <b aria-hidden="true">↗</b></span></a>
    </div>
  </section>
  <section class="wrap example-strip"><div><p class="eyebrow">CONTOH PENERAPAN</p><h2>Empat petugas, beberapa fungsi.</h2><p>Simulasi pembagian kerja untuk dua imam dan dua marbot.</p></div><a class="inline-link" href={href('contoh')}>Baca Masjid Contoh →</a></section>
</Site>
