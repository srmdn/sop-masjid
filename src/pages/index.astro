---
import Site from '../layouts/Site.astro';
import { href, materials } from '../lib/materials';
const featured = ['paket/masjid-dasar/sop-inti','paket/mushola-starter/template/jadwal-imam','paket/mushola-starter/template/kas','paket/masjid-dasar/alat-kerja'].map(slug=>materials.find(m=>m.slug===slug)!);
---
<Site><section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="dot">●</span> TOOLKIT GRATIS & TERBUKA</p><h1>Biar urusan masjid<br/>lebih <em>tertata.</em></h1><p class="lede">Dari jadwal imam sampai kebersihan harian. Panduan, SOP, dan checklist yang bisa disesuaikan dengan tim masjidmu.</p><div class="actions"><a class="button primary" href={href('materi')}>Jelajahi materi <span>↗</span></a><a class="text-link" href={href('mulai')}>Cara memakai →</a></div><p class="micro">Bebas dibaca, dicetak, dan diadaptasi · Tanpa instalasi</p></div><div class="hero-art" aria-label="Pratinjau contoh checklist kesiapan shalat"><span class="art-label">SEDIKIT LEBIH RAPI, SETIAP HARI.</span><div class="paper"><div class="paper-top"><span>CATATAN OPERASIONAL</span><span>01 / HARIAN</span></div><h2>Sebelum jamaah<br/>datang.</h2><p>Checklist kesiapan shalat</p><ul><li><span>✓</span> Imam & muadzin terkonfirmasi</li><li><span>✓</span> Area shalat bersih dan kering</li><li><span>✓</span> Air wudhu tersedia</li><li><span class="empty">□</span> Audio & akses diperiksa</li></ul><div class="paper-foot">PETUGAS <b>Marbot bertugas</b></div></div><div class="art-stamp">Tugas jelas.<br/>Tim lebih tenang.</div></div></section>
<section class="quick wrap" aria-label="Cari menurut kebutuhan"><p>Mau beresin<br/><strong>yang mana dulu?</strong></p>{[['paket/mushola-starter/template/jadwal-imam','01','Atur jadwal'],['paket/mushola-starter/template/kas','02','Catat kas'],['paket/mushola-starter/sop/kebersihan','03','Rawat area'],['paket/masjid-dasar/sop-inti','04','Bagi tugas']].map(([route,no,label])=><a href={href(route)}><span>{no}</span>{label}<b>↗</b></a>)}</section>
<section class="wrap section"><div class="section-heading"><div><p class="eyebrow">PERPUSTAKAAN KERJA</p><h2>Mulai dari yang dibutuhkan.</h2></div><a class="text-link" href={href('materi')}>Semua materi →</a></div><div class="card-grid">{featured.map((m,i)=><a class="material-card" href={href(m.slug)}><div class={`card-cover cover-${i}`}><span class="cover-number">0{i+1}</span><div class="mini-sheet"><span>{m.kind.toUpperCase()}</span><strong>{['Alur kerja\nharian','Jadwal imam\n& muadzin','Catatan kas\nmasuk–keluar','Checklist\n& catatan'][i]}</strong><div class="mini-lines"><i/><i/><i/></div></div></div><div class="card-info"><span class="tag">{m.kind}</span><h3>{m.title}</h3><p>{m.packageName}<span>↗</span></p></div></a>)}</div></section>
<section class="wrap section package-feature"><div><p class="eyebrow">SISTEM YANG BISA DISESUAIKAN</p><h2>Tim kecil.<br/>Pembagian kerja jelas.</h2><p>Mulai dari kesiapan shalat, kebersihan, dan pengganti petugas. Paket Masjid Dasar menyatukan peran, alur kerja, dan cara mencatat kendala.</p><a class="button primary" href={href('paket/masjid-dasar')}>Buka Paket Masjid Dasar ↗</a></div><div class="role-board"><div><span>01</span><strong>Pengurus</strong><p>Tetapkan mandat & evaluasi</p></div><div><span>02</span><strong>Koordinator</strong><p>Atur jadwal & tindak lanjut</p></div><div><span>03</span><strong>Petugas</strong><p>Jalankan & catat hasil</p></div><a href={href('contoh')}>Lihat simulasi Masjid Contoh →</a></div></section>
<section class="wrap section steps"><div><p class="eyebrow">CARA MEMAKAI</p><h2>Ambil. Sesuaikan.<br/>Jalankan bersama.</h2></div>{[['01','Pilih kebutuhan','Baca materi yang sesuai dengan layanan dan tim yang tersedia.'],['02','Sesuaikan bersama','Tentukan petugas, jadwal, dan kewenangan dengan pengurus.'],['03','Pakai & perbaiki','Cetak checklist, catat kendala, lalu evaluasi hasilnya.']].map(([no,title,desc])=><div><span>{no}</span><h3>{title}</h3><p>{desc}</p></div>)}</section></Site>
