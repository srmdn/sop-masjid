---
import Site from '../layouts/Site.astro';import {href,materials} from '../lib/materials';
---
<Site title="Materi"><section class="wrap page-head"><p class="eyebrow">PERPUSTAKAAN KERJA</p><h1>Ada panduan untuk<br/>urusan sehari-hari.</h1><p>Pilih, baca, lalu sesuaikan dengan masjidmu.</p></section><section class="wrap catalog section"><div class="catalog-tools"><label for="search">Cari materi<input id="search" type="search" placeholder="Coba: kas, imam, kebersihan…"/></label><label for="kind">Jenis materi<select id="kind"><option value="">Semua jenis</option>{['SOP','Template','Checklist','Panduan'].map(k=><option>{k}</option>)}</select></label></div><p id="count" class="micro" aria-live="polite">{materials.length} materi</p><div class="catalog-list">{materials.map((m,i)=><a class="catalog-item" data-kind={m.kind} data-search={`${m.title} ${m.packageName}`.toLocaleLowerCase('id')} href={href(m.slug)}><span class={`list-icon cover-${i%4}`}>{m.kind==='SOP'?'↳':m.kind==='Checklist'?'✓':m.kind==='Template'?'▤':'↗'}</span><div><span class="tag">{m.kind} · {m.packageName}</span><h2>{m.title}</h2></div><span class="arrow">↗</span></a>)}</div><p id="empty" hidden>Tidak ada materi yang cocok. Coba kata lain atau pilih semua jenis.</p><noscript><p>Semua materi tersedia pada daftar ini. Pencarian memerlukan JavaScript.</p></noscript></section></Site>
<script>
const search=document.querySelector<HTMLInputElement>('#search')!;const kind=document.querySelector<HTMLSelectElement>('#kind')!;const items=[...document.querySelectorAll<HTMLElement>('.catalog-item')];
function filter(){let count=0;const q=search.value.trim().toLocaleLowerCase('id');items.forEach(item=>{const show=(!kind.value||item.dataset.kind===kind.value)&&item.dataset.search!.includes(q);item.hidden=!show;if(show)count++;});document.querySelector('#count')!.textContent=`${count} materi`;document.querySelector<HTMLElement>('#empty')!.hidden=count!==0;}
search.addEventListener('input',filter);kind.addEventListener('change',filter);
</script>
