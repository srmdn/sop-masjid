---
import Site from '../layouts/Site.astro';
import { href } from '../lib/materials';
const packages = [
  ['01', 'mushola-starter', 'Paket Mushola Starter', 'Administrasi dan pemeriksaan dasar untuk tim dengan tugas terbatas.', '4 SOP', 'Jadwal, kas, inventaris, checklist harian dan mingguan.'],
  ['02', 'masjid-dasar', 'Paket Masjid Dasar', 'Rutinitas masjid dengan pembagian tugas dan pengganti petugas.', '10 SOP inti', 'Peran, kegiatan, fasilitas, belanja, serta format catatan operasional.'],
];
---
<Site title="Paket">
  <section class="wrap page-head"><p class="eyebrow">KOLEKSI PANDUAN</p><h1>Paket operasional.</h1><p>Pilih menurut tugas yang perlu dikelola dan petugas yang tersedia.</p></section>
  <section class="wrap package-list" aria-label="Paket tersedia">
    {packages.map(([no, slug, title, description, count, contents]) => <a class="package-row" href={href(`paket/${slug}`)}><span class="entry-number">{no}</span><div><span class="eyebrow">PANDUAN ADAPTASI</span><h2>{title}</h2><p>{description}</p></div><div class="package-contents"><strong>{count}</strong><p>{contents}</p><span class="entry-action">Baca paket ↗</span></div></a>)}
  </section>
  <section class="wrap planned"><p class="eyebrow">BELUM TERSEDIA</p><h2>Paket dalam rencana</h2><ul>{['Masjid Aktif', 'Masjid Lengkap', 'Keuangan Masjid', 'Ramadhan', 'Kurban', 'Digital Admin', 'Serah Terima Pengurus'].map(p => <li>{p}</li>)}</ul></section>
</Site>
